<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="catalog.json" />
        <include domain="sharedpref" path="pixelstore_session.xml" />
        <exclude domain="file" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="catalog.json" />
        <include domain="sharedpref" path="pixelstore_session.xml" />
    </device-transfer>
</data-extraction-rules>
